{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-select",
    "fs:default",
    "fs:allow-app-read",
    "fs:allow-app-write",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    "fs:allow-copy-file",
    "fs:allow-read-file",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "process:allow-restart"
  ]
}